# Hybrid OpenJarvis: cloud inference + local memory + MCP SSE for Cursor
FROM node:22-slim AS frontend

WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci --ignore-scripts 2>/dev/null || npm install
COPY frontend/ .
ENV VITE_DISABLE_PWA=1
RUN npm run build

FROM python:3.12-slim-bookworm AS builder

RUN apt-get update && \
    apt-get install -y --no-install-recommends curl build-essential pkg-config libssl-dev && \
    rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable
ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src/ src/
COPY rust/ rust/
COPY scripts/install scripts/install
COPY deploy/windows deploy/windows
COPY deploy/docker/scripts/verify_hybrid_deps.py deploy/docker/scripts/verify_hybrid_deps.py
COPY --from=frontend /src/openjarvis/server/static src/openjarvis/server/static/

# Single named extra owns the hybrid runtime. Ad-hoc pip lines here have
# historically drifted (missing orjson / cryptography / pdfplumber) and
# surfaced as mid-chat "No module named …" errors. Build FAILS if verify
# reports a required import missing.
RUN pip install --no-cache-dir uv && \
    uv pip install --system ".[hybrid]" && \
    # markitdown-mcp pins conflict with the MCP SDK when resolved together;
    # install with --no-deps after mcp is already present.
    uv pip install --system "markitdown-mcp" --no-deps && \
    python deploy/docker/scripts/verify_hybrid_deps.py && \
    uv pip install --system "maturin>=1.12" && \
    maturin build --release -m rust/crates/openjarvis-python/Cargo.toml -o /tmp/wheels && \
    uv pip install --system /tmp/wheels/*.whl

FROM python:3.12-slim-bookworm

RUN apt-get update && \
    apt-get install -y --no-install-recommends curl ffmpeg git && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local /usr/local
COPY --from=builder /app /app
WORKDIR /app

# Playwright Chromium for browser_navigate / browser_* agent tools.
# Browsers live under /opt/playwright (not /root/.cache) so the host cache
# volume mount in docker-compose does not hide them on container start.
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/playwright
RUN mkdir -p /opt/playwright && \
    playwright install --with-deps chromium

COPY deploy/docker/scripts/ /app/deploy/docker/scripts/
RUN sed -i 's/\r$//' /app/deploy/docker/scripts/entrypoint.sh && \
    sed -i 's/\r$//' /app/deploy/docker/scripts/inject_web_bootstrap.py && \
    sed -i 's/\r$//' /app/deploy/docker/scripts/verify_hybrid_deps.py && \
    chmod +x /app/deploy/docker/scripts/entrypoint.sh

EXPOSE 8000 8888
ENTRYPOINT ["sh", "/app/deploy/docker/scripts/entrypoint.sh"]
